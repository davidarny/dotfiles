{
  "$schema": "https://opencode.ai/config.json",
  "shell": "{env:HOME}/.config/zsh/agent/zsh",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "fff": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/fff-mcp"
      ],
      "environment": {
        "FFF_MCP_IDLE_TIMEOUT_SECS": "0"
      },
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      },
      "oauth": false,
      "enabled": true
    },
    "hindsight": {
      "type": "remote",
      "url": "https://api.hindsight.vectorize.io/mcp/shared-memory/",
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_MCP_TOKEN}"
      },
      "oauth": false,
      "enabled": true
    }
  },
  "provider": {
    "dats.team": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Dats.AI",
      "options": {
        "baseURL": "https://llm.dats.services/v1",
        "apiKey": "{env:DATS_TEAM_AI_API_KEY}"
      },
      "models": {
        "coding-agent-default": {
          "name": "coding-agent"
        }
      }
    }
  }
}
