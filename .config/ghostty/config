theme = "tokyonight"
macos-icon = "custom"
macos-custom-icon = "~/.config/ghostty/tokyo-night.icns"

font-size = 14
font-family = "JetBrainsMono Nerd Font"

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

clipboard-read = allow
clipboard-write = allow
macos-option-as-alt = true

# Send ZLE-compatible sequences for Command-Shift line selection.
keybind = cmd+shift+arrow_left=csi:1;10D
keybind = cmd+shift+arrow_right=csi:1;10C
