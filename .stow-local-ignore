# Junk files: ignore anywhere (basename match, no /)
.DS_Store
\.gitignore

# Regexes containing / match full paths, so these ignore only repo-root entries.
# Nested same-named files stay stowed (e.g. .local/bin/*).
/\.git$
/\.codegraph$
/\.pi\/tasks$
/bin$
/AGENTS\.md$
/Brewfile$
/CLAUDE\.md$
/LICENSE\.md$
/README\.md$
/justfile$

# Karabiner rewrites its config and needs the whole directory linked (just link does it)
/\.config\/karabiner$

# Generated agent snapshots (just claude-dump / codex-dump / pi-dump) — copied by restore, never stowed
/\.pi\/agent\/settings\.json$
/\.claude\/mcp-servers\.json$
/\.claude\/settings\.json$
/\.codex\/mcp-servers\.toml$
/\.codex\/settings\.toml$

# Skills manifest and local skills are read from the repo (just skills-sync links them);
# the CLI lockfile is machine-local
/\.agents\/skills\.json$
/\.agents\/skills$
/\.agents\/\.skill-lock\.json$

# Bun global lockfile is machine-local
/\.bun\/install\/global\/bun\.lock$
