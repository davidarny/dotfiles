[include]
  path = ~/.config/git/core.gitconfig

[include]
  path = ~/.config/git/user.gitconfig

[includeIf "gitdir:~/Developer/dats.team/"]
  path = ~/.config/git/dats-team.gitconfig

[include]
  path = ~/.config/git/appearance.gitconfig

[include]
  path = ~/.config/git/behavior.gitconfig

[include]
  path = ~/.config/git/tools.gitconfig

[include]
  path = ~/.config/git/aliases.gitconfig

[include]
  path = ~/.config/git/credentials.gitconfig
