{
  "codegraph": {
    "type": "stdio",
    "command": "codegraph",
    "args": [
      "serve",
      "--mcp"
    ]
  },
  "fff": {
    "type": "stdio",
    "command": "/opt/homebrew/bin/fff-mcp",
    "env": {
      "FFF_MCP_IDLE_TIMEOUT_SECS": "0"
    }
  },
  "context7": {
    "type": "stdio",
    "command": "bunx",
    "args": [
      "-y",
      "@upstash/context7-mcp@4.1.1"
    ],
    "env": {
      "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
    }
  },
  "exa": {
    "type": "http",
    "url": "https://mcp.exa.ai/mcp",
    "headers": {
      "x-api-key": "${EXA_API_KEY}"
    }
  },
  "hindsight": {
    "type": "http",
    "url": "https://api.hindsight.vectorize.io/mcp/shared-memory/",
    "headers": {
      "Authorization": "Bearer ${HINDSIGHT_MCP_TOKEN}"
    }
  },
  "atlassian-jira-dc": {
    "type": "stdio",
    "command": "bunx",
    "args": [
      "-y",
      "@atlassian-dc-mcp/jira@0.35.0"
    ],
    "env": {
      "JIRA_HOST": "jira.dats.tech",
      "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
    },
    "timeout": 120000
  },
  "atlassian-confluence-dc": {
    "type": "stdio",
    "command": "bunx",
    "args": [
      "-y",
      "@atlassian-dc-mcp/confluence@0.35.0"
    ],
    "env": {
      "CONFLUENCE_HOST": "confluence.dats.tech",
      "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
    },
    "timeout": 120000
  },
  "grafana": {
    "type": "stdio",
    "command": "/opt/homebrew/bin/mcp-grafana",
    "env": {
      "GRAFANA_URL": "https://grafana.dats.services",
      "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
    },
    "timeout": 120000
  },
  "elasticsearch-main": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "--python",
      "3.12",
      "elasticsearch-mcp-server@2.1.3"
    ],
    "env": {
      "ELASTICSEARCH_HOSTS": "https://elastic-logs-htzn-2.infra.dats.host:9200,https://elastic-logs-htzn-3.infra.dats.host:9200,https://elastic-logs-htzn-4.infra.dats.host:9200",
      "ELASTICSEARCH_USERNAME": "d.arutyunyan",
      "ELASTICSEARCH_PASSWORD": "${ELASTICSEARCH_PASSWORD}",
      "DISABLE_HIGH_RISK_OPERATIONS": "true",
      "VERIFY_CERTS": "false"
    }
  },
  "mostbet-elasticsearch": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "--python",
      "3.12",
      "elasticsearch-mcp-server@2.1.3"
    ],
    "env": {
      "ELASTICSEARCH_HOSTS": "https://elastic-logs-mostbet-frnx-1.prod.dats.host:9200",
      "ELASTICSEARCH_USERNAME": "d.arutyunyan",
      "ELASTICSEARCH_PASSWORD": "${ELASTICSEARCH_PASSWORD}",
      "DISABLE_HIGH_RISK_OPERATIONS": "true",
      "VERIFY_CERTS": "false"
    }
  },
  "testrail": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "testrail-mcp@0.1.5"
    ],
    "env": {
      "TESTRAIL_URL": "http://media.test8bit.com/testrail",
      "TESTRAIL_USERNAME": "readonly@8bitov.com",
      "TESTRAIL_API_KEY": "${TESTRAIL_API_KEY}"
    }
  },
  "minio": {
    "type": "stdio",
    "command": "bunx",
    "args": [
      "-y",
      "github:chenchiwei/s3-mcp-server#ceebf773d6881fb6cd3abc80709088d4792518c6"
    ],
    "env": {
      "AWS_ENDPOINT_URL": "https://minio-synthetic-tests-perf.infra.dats.host",
      "AWS_REGION": "eu-west-1",
      "AWS_ACCESS_KEY_ID": "${MINIO_ACCESS_KEY_ID}",
      "AWS_SECRET_ACCESS_KEY": "${MINIO_SECRET_ACCESS_KEY}",
      "ALLOW_WRITE": "false"
    }
  }
}
