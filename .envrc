# Find the closest project environment, including 1Password FIFOs.
dotenv_dir=${DIRENV_WORK_DIR:-$PWD}

while [[ "$dotenv_dir" == "$HOME" || "$dotenv_dir" == "$HOME/"* ]]; do
  if [[ -f "$dotenv_dir/.env" || -p "$dotenv_dir/.env" || \
        -f "$dotenv_dir/.env.local" || -p "$dotenv_dir/.env.local" ]]; then
    dotenv_if_exists "$dotenv_dir/.env"
    dotenv_if_exists "$dotenv_dir/.env.local"
    break
  fi

  [[ "$dotenv_dir" == "$HOME" ]] && break
  dotenv_dir=$(dirname "$dotenv_dir")
done

unset dotenv_dir
