#!/usr/bin/env zsh
# Publish MCP secrets to the launchd GUI session so apps started from Dock or at login inherit them.
set -euo pipefail

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/mcp/mcp-secrets.env"
if [[ ! -f "$env_file" ]]; then
  echo "mcp-secrets-launchctl: $env_file is missing; run just mcp-secrets" >&2
  exit 1
fi

source "$env_file"
for name in ${(f)"$(sed -nE 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$env_file")"}; do
  launchctl setenv "$name" "${(P)name}"
done
